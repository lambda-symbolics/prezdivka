(in-package #:prezdivka/tests)

(defun tests--words ()
  "Exercise the shape of the word lists."
  (dolist (words (list prezdivka:*adjectives* prezdivka:*nouns*))
    (test-assert (every (lambda (word)
                          (and (<= 2 (length word) 12)
                               (every (lambda (character) (char<= #\a character #\z)) word)))
                        words)
                 "every word is two to twelve lowercase ASCII letters")
    (test-assert (= (length words) (length (remove-duplicates words :test #'string=)))
                 "no word is listed twice"))
  (test-assert (>= (prezdivka:name-count) 8000) "the lists make thousands of names")
  nil)

(defun tests--names ()
  "Exercise names for keys, random names and names nobody has."
  (test-assert (string= (prezdivka:name-for "b6uouHJ") (prezdivka:name-for "b6uouHJ"))
               "a key always gets the same name")
  (test-assert (string= (prezdivka:name-for "b6uouHJ") "strict-gensym")
               "the name of a key does not change between images or releases")
  (test-assert (> (length (remove-duplicates
                            (loop for index below 200 collect (prezdivka:name-for (format nil "key-~D" index)))
                           :test #'string=))
                  190)
               "different keys mostly get different names")
  (let ((name (prezdivka:random-name)))
    (test-assert (and (find (subseq name 0 (position #\- name)) prezdivka:*adjectives* :test #'string=)
                      (find (subseq name (1+ (position #\- name))) prezdivka:*nouns* :test #'string=))
                 "a random name is an adjective and a noun"))
  (let* ((adjectives #("lazy" "eager"))
         (nouns      #("thunk" "cons" "quux"))
         (taken      nil)
         (names      (loop repeat 6
                           collect (let ((name (prezdivka:unique-name
                                                "key" (lambda (name) (member name taken :test #'string=))
                                                :adjectives adjectives :nouns nouns)))
                                     (push name taken)
                                     name))))
    (test-assert (string= (first names) (prezdivka:name-for "key" :adjectives adjectives :nouns nouns))
                 "the name of the key comes first when it is free")
    (test-assert (= 6 (length (remove-duplicates names :test #'string=)))
                 "every name is offered once before any gets a number")
    (test-assert (string= (prezdivka:unique-name "key" (lambda (name) (member name taken :test #'string=))
                                               :adjectives adjectives :nouns nouns)
                          (format nil "~A-2" (first names)))
                 "with every name taken, the key's own gets the lowest free number"))
  nil)

(defun tests--explicit-base ()
  "Exercise explicit base order, suffix room, and finite exhaustion."
  (test-assert (string= "branch" (prezdivka:unique-base-name "branch" (constantly nil)))
               "an available base is returned unchanged")
  (let ((seen nil))
    (test-assert (string= "br-3" (prezdivka:unique-base-name
                                  "branch" (lambda (name)
                                             (push name seen)
                                             (< (length seen) 3))
                                  :maximum-length 4))
                 "the first free numbered name fits the length limit")
    (test-assert (equal (reverse seen) '("bran" "br-2" "br-3"))
                 "the truncated base precedes numbered suffixes, starting at two"))
  (test-assert (handler-case
                   (progn
                     (prezdivka:unique-base-name "branch" (constantly t) :maximum-length 2)
                     nil)
                 (prezdivka:base-name-exhausted () t))
               "no name is fabricated past the maximum length")
  nil)

(defun run-tests ()
  "Run every prezdivka regression test."
  (setf *test-count* 0)
  (tests--words)
  (tests--names)
  (tests--explicit-base)
  (format t "~&~:D prezdivka tests passed.~%" *test-count*)
  nil)
